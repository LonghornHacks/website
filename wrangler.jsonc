{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  }
}